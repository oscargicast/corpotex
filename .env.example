# Copiar a .env y completar. Nunca commitear .env.

# Evolution API, instancia corpotex (número de Oscar)
EVOLUTION_API_URL=https://evolution.oscargicast.com
EVOLUTION_INSTANCE=corpotex
EVOLUTION_INSTANCE_TOKEN=
# Secreto en la URL del webhook: https://corpotex.oscargicast.com/webhooks/evolution/<secreto>/
EVOLUTION_WEBHOOK_SECRET=

# Cloudflare Access service token (Evolution está detrás de Access)
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Postgres (docker compose)
DATABASE_URL=postgres://corpotex:corpotex@localhost:5432/corpotex

# Claude (agente y extracción de estilo, ADR 0013)
# Token de la suscripción: generarlo con `claude setup-token` en otra terminal.
CLAUDE_CODE_OAUTH_TOKEN=
# Para producción, en su lugar: ANTHROPIC_API_KEY=
