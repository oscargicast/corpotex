DEBUG=False  # True solo en desarrollo sin tunnel
# Copiar a .env y completar. Nunca commitear .env.

# Evolution API, instancia corpotex (número de Oscar)
EVOLUTION_API_URL=https://evolution.oscargicast.com
EVOLUTION_INSTANCE=corpotex
EVOLUTION_INSTANCE_TOKEN=
# Secreto en la URL del webhook: https://corpotex.oscargicast.com/webhooks/evolution/<secreto>/
EVOLUTION_WEBHOOK_SECRET=

# Cloudflare Access service token (Evolution está detrás de Access)
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Postgres (docker compose arma DATABASE_URL con esta clave; solo escucha en 127.0.0.1)
POSTGRES_PASSWORD=corpotex

# Claude: no va aquí. El Gerente conecta su cuenta desde el dashboard (/settings/claude, ADR 0022)
# y la credencial queda en el volumen agent-home (CLAUDE_CONFIG_DIR).

# Django admin superuser created by `seed_demo` (idempotent).
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=

# Password of the three seeded role users (gerente, comercial, produccion).
# When unset, seed_demo falls back to username = password (development only).
SEED_USERS_PASSWORD=
STYLE_REFRESH_ENABLED=True  # False congela el estilo aprobado (noche de la demo): refresh_style no toca nada
